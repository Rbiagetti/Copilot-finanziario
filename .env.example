# ─────────────────────────────────────────────────────────
# FinCopilot — Backend Environment Variables
# Copia questo file in .env e compila con i tuoi valori
# MAI committare il file .env
# ─────────────────────────────────────────────────────────

# Groq API — OBBLIGATORIA
# Ottieni la chiave su https://console.groq.com (gratuito)
GROQ_API_KEY=gsk_...

# Database — lascia il default per sviluppo locale
DATABASE_URL=sqlite:///./data/fincopilot.db

# Supabase — per autenticazione JWT
# Ottieni le credenziali su https://supabase.com (gratuito)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Debug AI (opzionali)
AI_DEBUG_ROUTING=0    # 1 = log routing in console
AI_DISABLE_LLM=0      # 1 = disabilita Groq (risponde OOS, per debug UI)
