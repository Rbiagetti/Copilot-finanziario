# ── AI ────────────────────────────────────────────────────────────────────────
# Obbligatoria — ottieni la chiave su https://console.groq.com (piano gratuito ok)
GROQ_API_KEY=gsk_your_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite locale per sviluppo (default). Sostituire con postgres:// per produzione.
DATABASE_URL=sqlite:///./data/fincopilot.db

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Progetto Supabase: https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Debug (opzionali) ─────────────────────────────────────────────────────────
AI_DEBUG_ROUTING=0      # 1 = stampa in console il routing AI per ogni domanda
AI_DISABLE_LLM=0        # 1 = bypassa le chiamate Groq (utile per debug frontend)
